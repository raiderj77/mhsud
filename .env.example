# No display advertising. There are no ad activation settings.
# GA4 is not used. Vercel Web Analytics is controlled in application code.

# Facilities listing service checkout gate. Leave empty: purchase CTAs render
# disabled ("checkout not open yet"). Set only when the owner creates the
# Stripe products and legal review of the service terms is complete.
NEXT_PUBLIC_FACILITY_SERVICES_ORDER_URL=

# Professional backend stays disabled until all three values are set.
# Supabase project URL and public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private Supabase service-role key. Server and pilot scripts only.
SUPABASE_SERVICE_ROLE_KEY=
